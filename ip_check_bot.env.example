# Идеи дополнительных API (RU-обзор): см. open_apis_ru.txt в этом каталоге.

# Обязательно для Telegram Bot API на mor (см. ~/PROXY.md)
TG_SOCKS_PROXY=socks5://127.0.0.1:1080

# Токен от @BotFather
BOT_TOKEN=

# Если 1 — не стартовать без TG_SOCKS_PROXY
IP_CHECK_REQUIRE_PROXY=1

# Если 1 — Bot API (getUpdates) без SOCKS; проверки IP всё равно через TG_SOCKS_PROXY.
# На mor часто нужно из‑за httpx.ConnectError на start_tls через mixed (аналог TG_BOT_NO_PROXY в filmekom).
# IP_CHECK_TG_NO_PROXY=1

# API-ключи VT / OTX / AbuseIPDB — предпочтительно в отдельном файле (не коммитить):
#   cp secrets/keys.example.json secrets/keys.json
#   chmod 600 secrets/keys.json
# и укажите путь:
IP_CHECK_KEYS_JSON=/home/bxr/ip-check-telegram-bot/secrets/keys.json
#
# Либо задайте прямо в env (fallback; keys.py: сначала env, потом JSON):
# VT_API_KEY=
# OTX_API_KEY=
# ABUSEIPDB_API_KEY=
# AbuseIPDB (только детальный отчёт 1 IP): https://www.abuseipdb.com/api
# Окно жалоб в днях для API (1–365; на сайте «всего жалоб» = в этом окне). Бесплатный план может ограничить — тогда будет 422 и fallback на 90 дн.
# IP_CHECK_ABUSE_MAX_AGE_DAYS=365
# Сколько страниц /reports догружать (по 100 записей), если check вернул не все жалобы
# IP_CHECK_ABUSE_REPORT_PAGES_MAX=200

# Глобальные значения по умолчанию для новых пользователей: 1/0
IP_CHECK_DEFAULT_GEO=1
IP_CHECK_DEFAULT_VT=1
IP_CHECK_DEFAULT_OTX=1
IP_CHECK_DEFAULT_ABUSE=1
IP_CHECK_DEFAULT_RIPE=1

# Параллельных запросов VT/OTX при массовой проверке (1–32)
# IP_CHECK_BULK_CONCURRENCY=12

# Лимиты/таймауты: при первом запуске копируются в data/runtime_config.json.
# Админ меняет их в /admin → ⚙️ без перезапуска. Env — только начальные значения.
# IP_CHECK_MAX_IPS_PER_REQUEST=80
# IP_CHECK_ONLINE_IDLE_MINUTES=15
# Кэш результатов проверки IP (data/lookup_cache.json), по умолчанию 24 ч
# IP_CHECK_LOOKUP_CACHE_TTL_HOURS=24

# Кнопок 🔴 «точечно» после массовой проверки (макс. 40)
# IP_CHECK_RED_BUTTONS_MAX=20

# JSON настроек пользователей (создаётся автоматически)
# IP_CHECK_DATA_DIR=/home/bxr/ip-check-telegram-bot/data

# Ограничить бота: union(env + data/allowed_users.json). Пусто в обоих = доступ всем.
# IP_CHECK_ALLOWED_USER_IDS=12345,67890
# При первом запуске с админом список из env копируется в allowed_users.json (если файл пуст).

# Ваш Telegram user id (обязательно для /admin). Несколько через запятую.
# IP_CHECK_ADMIN_USER_IDS=12345

# Журнал проверок: data/audit.jsonl (кто / когда / сколько IP / какие адреса)
# IP_CHECK_AUDIT_MAX_LINES=5000
# IP_CHECK_AUDIT_IPS_MAX=80

# Домены за IP (только точечный отчёт): PTR + VT resolutions + OTX passive DNS + AbuseIPDB
# IP_CHECK_HOST_MAX_DOMAINS=80
# IP_CHECK_HOST_TG_SHOW=20

# Анализ pcap/pcapng (tshark) и логов DROP — /dump
# IP_CHECK_DUMP_MAX_MB=15
# IP_CHECK_DUMP_TIMEOUT_SEC=90
# IP_CHECK_TSHARK=/usr/bin/tshark

# ZIP с PCAP (admin /dump): распаковка и выбор файла кнопкой
# IP_CHECK_DUMP_ZIP_MAX_MB=50
# IP_CHECK_DUMP_ZIP_MAX_FILES=20

LOG_LEVEL=INFO
